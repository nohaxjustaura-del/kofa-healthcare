.vercel
.env*
# ...except the template, which carries no secrets and is the only record of
# which variables the deployment actually reads. `.env*` above swallowed it,
# so the file existed locally and was invisible to everyone who cloned.
!.env.example

# Scratch page dumps from debugging sessions
home_dump.html

# Generated by `next dev` and `next build`, and rewritten by each to point at
# its own output directory (.next-dev vs .next, see next.config.ts), so a
# tracked copy showed as modified after every switch between the two. Next
# regenerates it on every run, and CI builds before it type-checks.
next-env.d.ts
