# KOFA Healthcare — environment
# ---------------------------------------------------------------------------
# Copy to .env.local for development, or set these in the Vercel project's
# Environment Variables. Nothing here is required for the site to build and
# render; they only affect where the contact form delivers.


# --- Contact form delivery -------------------------------------------------
#
# /api/contact tries every channel configured below and reports success if any
# one of them accepts the submission. Configure NONE of them and the endpoint
# returns 501, at which point the form falls back to opening the visitor's
# mail client with the message pre-filled. That fallback is deliberate: the
# form never tells someone "sent" for a message that went nowhere.


# Option 1 — email via Resend (https://resend.com). Recommended.
#
# RESEND_API_KEY and CONTACT_FROM_EMAIL must BOTH be set; a key without a
# verified sender is treated as unconfigured, because Resend would reject
# every send. The sender domain has to be verified in the Resend dashboard.
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_FROM_EMAIL=website@mail.kofahealthcare.com
#
# Where enquiries land. Defaults to site.email (info@kofahealthcare.com) when
# unset, so this is only needed to route somewhere else.
# CONTACT_TO_EMAIL=info@kofahealthcare.com


# Option 2 — any endpoint that accepts a JSON POST.
#
# The bridge to WordPress (WPForms / Gravity Forms REST), to a CRM, to Zapier
# or Make, or to a Slack relay. The body is:
#
#   { name, email, company, website, reason, message, receivedAt }
#
# with receivedAt an ISO 8601 timestamp. A non-2xx response counts as a
# failed delivery for this channel.
#
# KOFA_CONTACT_WEBHOOK=https://hooks.example.com/kofa-contact


# --- Site URL --------------------------------------------------------------
#
# Canonical origin, used for metadata, sitemap.xml, robots.txt and Open Graph
# image URLs. Falls back to https://www.kofahealthcare.com. On Vercel preview
# deployments, leaving this unset is usually what you want.
#
# NEXT_PUBLIC_SITE_URL=https://www.kofahealthcare.com
