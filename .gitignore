# dependencies
node_modules/
.pnp
.pnp.*

# next.js build output
# `.next` is the production dir and `.next-dev` the dev one; next.config.ts
# splits them so a dev server and a production server can share a checkout.
# KOFA_DIST_SUFFIX appends to the dev name, so a second dev server on another
# port gets `.next-dev-b` instead of fighting the first one for the same
# manifests. The glob covers every suffix.
.next/
.next-dev*/
out/
build/
dist/

# typescript incremental build state
*.tsbuildinfo

# environment
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# testing / coverage
coverage/

# vercel
.vercel

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# editor / os
.DS_Store
Thumbs.db
.idea/
*.swp
